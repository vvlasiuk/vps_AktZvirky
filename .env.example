# Telegram
TELEGRAM_TOKEN=123456:ABC-DEF...
TELEGRAM_POLL_TIMEOUT=30
# Chat_id адміністратора для сповіщень про збої (не обов'язково)
ADMIN_CHAT_ID=
# Offset getUpdates — просувається лише після успішної обробки (без БД, як у vps_input_msg_telegram)
TELEGRAM_OFFSET_FILE=storage/offset.txt
# Файл команд бота (setMyCommands при старті); якщо не існує — команди не змінюються
COMMANDS_FILE=commands.json

# 1C COM
# Для файлової бази вкажіть ONEC_FILE_PATH — тоді ONEC_SERVER/ONEC_REF ігноруються
ONEC_SERVER=localhost
ONEC_REF=YourBase
ONEC_FILE_PATH=
ONEC_USER=User
ONEC_PASSWORD=Password
ONEC_CONNECTOR_PROG_ID=V83.COMConnector
ONEC_RECONNECT_INTERVAL_SEC=60

# Опитування задач у 1С (VPS.CreateTask / VPS.StatusTask)
POLL_INTERVAL_SEC=2
TASK_TIMEOUT_SEC=300
LOOP_SLEEP_SEC=0.2

# Сховище стану — лише незавершені задачі 1С (для відновлення після рестарту),
# без діалогового стану. SQLite, окремий сервер БД не потрібен.
DB_PATH=storage/state.sqlite3
TEMP_FILES_DIR=storage/tmp

# Логування
LOG_LEVEL=ERROR
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
LOG_FILE=logs/service.log

# Окремий лог запитів (хто/коли/яку команду/з якими параметрами відправив
# у 1С) — не залежить від LOG_LEVEL вище, пишеться завжди.
REQUEST_LOG_FILE=logs/requests.log
